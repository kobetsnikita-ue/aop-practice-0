import time

N = 10_000_000
data_list = list(range(N))
data_set = set(range(N))

target = -1

start_list = time.perf_counter()
found_in_list = target in data_list
end_list = time.perf_counter()
time_list = end_list - start_list

start_set = time.perf_counter()
found_in_set = target in data_set
end_set = time.perf_counter()
time_set = end_set - start_set

print(f"Пошук у List (O(N)): {time_list:.6f} сек")
print(f"Пошук у Set  (O(1)): {time_set:.6f} сек")
print(f"Set швидший приблизно у {time_list / time_set:,.0f} разів")

