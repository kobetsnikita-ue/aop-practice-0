# Завдання 10.1 

def fast_power(x: float, n: int) -> float:
    if n < 0:
        return 1 / fast_power(x, -n)

    if n == 0:
        return 1

    half = fast_power(x, n // 2)
    
    if n % 2 == 0:
        return half * half
    else:
        return x * half * half

print(fast_power(2, 10))  # Виведе: 1024
print(fast_power(2, -3))  # Виведе: 0.125

