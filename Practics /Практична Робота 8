def build_prefix_sums(consumption: list[float]) -> list[float]:
    """
    Будує масив префіксних сум довжиною N + 1.
    prefix[i] зберігає суму перших i елементів (від індексу 0 до i-1).
    """
    n = len(consumption)
    prefix = [0.0] * (n + 1)
    for i in range(n):
        prefix[i + 1] = prefix[i] + consumption[i]
    return prefix


def get_range_consumption(prefix: list[float], left: int, right: int) -> float:
    """
    Повертає суму енергоспоживання на відрізку [left, right] включно (0-індексація).
    Складність: O(1).
    """
    if left < 0 or right >= len(prefix) - 1 or left > right:
        raise IndexError("Некоректні межі інтервалу [left, right]")
    return prefix[right + 1] - prefix[left]


hourly_energy = [1.2, 1.5, 2.3, 3.1, 2.8, 1.9, 1.4]

prefix_sums = build_prefix_sums(hourly_energy)

queries = [
    (0, 2),  
    (2, 5), 
    (4, 4),  
]

for l, r in queries:
    total = get_range_consumption(prefix_sums, l, r)
    print(f"Споживання за період [{l}, {r}]: {total:.2f} кВт·год")
