def analyze_stock_prices(prices: list[float], k: int) -> tuple[float, float]:
    """
    Знаходить максимальну суму та середнє значення цін у вікні розміру k.
    Складність за часом: O(N), за пам'яттю: O(1).
    """
    n = len(prices)
    if n < k or k <= 0:
        raise ValueError("Некоректний розмір вікна k відносно довжини масиву")

    window_sum = sum(prices[:k])
    max_sum = window_sum

    for i in range(k, n):
        window_sum += prices[i] - prices[i - k]
        if window_sum > max_sum:
            max_sum = window_sum

    max_avg = max_sum / k
    return max_sum, max_avg


prices = [100.5, 102.0, 98.5, 105.0, 110.0, 108.5, 103.0]
k = 3

max_total, max_average = analyze_stock_prices(prices, k)
print(f"Максимальна сума за {k} дн.: {max_total:.2f}")
print(f"Максимальна середня ціна: {max_average:.2f}")

