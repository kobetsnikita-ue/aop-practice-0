def counting_sort(arr):
    if not arr:
        return []
    
    max_val = max(arr)

    count = [0] * (max_val + 1)

    for num in arr:
        count[num] += 1

    sorted_arr = []
    for num in range(len(count)):
        sorted_arr.extend([num] * count[num])
        
    return sorted_arr

data = [4, 2, 2, 8, 3, 3, 1, 0, 4, 0]
result = counting_sort(data)
print("Відсортований масив:", result)
