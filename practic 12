# Задача 12.1
# bubble sort
numbers = [23, 76, 34, 98, 2, 91, 10]
n = len(numbers)

for i in range(n - 1):
    for j in range(n - 1 - i):
        print(i, j, numbers)
        if numbers[j] > numbers[j + 1]:
            numbers[j], numbers[j + 1] = numbers[j + 1], numbers[j]

print("Відсортований список:", numbers)

# Задача 12.2
#counting sort
numbers = [4, 2, 2, 8, 3, 3, 1]
max_val = max(numbers)
count = [0] * (max_val + 1)
for num in numbers:
    count[num] += 1

sorted_numbers = []  # Виправлено тут
for val in range(len(count)):
    sorted_numbers.extend([val] * count[val])

print(sorted_numbers)



